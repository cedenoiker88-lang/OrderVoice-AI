# Por defecto se usa Ollama local (sin API de pago).
# Copia a .env.local solo si deseas cambiar los valores por defecto.
ORDERVOICE_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:3b

# Opción alternativa: ORDERVOICE_PROVIDER=demo (reglas básicas, sin modelo)
# OpenAI es opcional y puede generar cargos SOLO si seleccionas ORDERVOICE_PROVIDER=openai.
# OPENAI_API_KEY=
# OPENAI_MODEL=

# v0.6 - Voz telefónica de OpenAI: DESACTIVADA por defecto.
# Para activarla, añade las líneas siguientes a tu .env.local privado:
# OPENAI_API_KEY=sk-...   # No la incluyas en capturas ni commits
# ORDERVOICE_TTS_PROVIDER=openai
# ORDERVOICE_TTS_TIMEOUT_MS=6500
#
# Con ORDERVOICE_TTS_PROVIDER=twilio (o sin configurar) se usa la voz anterior.
# El motor de pedidos se puede mantener en ORDERVOICE_PROVIDER=ollama.
# El audio TTS utiliza créditos facturables de OpenAI, por separado de Twilio.
# El modelo provisional gpt-4o-mini-tts se retirará el 6 de enero de 2027.

# v0.6: respuestas telefónicas rápidas y pregrabadas.
# Evita la espera de 25 s de OpenAI durante una llamada.
# Si falta la frase exacta, utiliza la voz básica de Twilio de inmediato.
# ORDERVOICE_PHONE_FAST_MODE=enabled

# v0.8 - Dictado con transcripción OpenAI desde el navegador (OPCIONAL).
# Desactivado por defecto: si no lo configuras, no se envía audio a OpenAI.
# Para activar, en tu .env.local privado:
# ORDERVOICE_BROWSER_STT_PROVIDER=openai
# OPENAI_API_KEY=tu_clave_privada_existente
# No necesita Twilio ni ngrok. La API de transcripción SÍ consume créditos OpenAI.
# Solo accesible desde http://localhost (NO expuesto en un túnel público).
# Puedes mantener ORDERVOICE_PROVIDER=demo u ollama para el motor de pedidos.

# v0.9 - Pedidos complejos en web (NO altera la telefonía).
# Para activar el intérprete con varias operaciones, en .env.local privado:
# ORDERVOICE_PROVIDER=openai
# ORDERVOICE_INTENT_MODEL=gpt-6.1-sol
# OPENAI_API_KEY=clave_privada
# Si necesitas menor latencia y costo, compara con: gpt-6.1-terra
# La API interpreta el texto transcrito; el servidor aplica cambios atómicamente.
