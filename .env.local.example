# OrderVoice AI · Criterio 2 · Monolito académico.
# Copia este archivo a .env.local y modifica únicamente tu instalación.
# NUNCA publiques contraseñas ni API keys.
DATABASE_URL=postgresql://postgres:TU_PASSWORD_LOCAL@localhost:5432/ordervoice_db

# La única API externa autorizada es voz a texto.
# Para una demostración con transcripción OpenAI:
ORDERVOICE_BROWSER_STT_PROVIDER=openai
# OPENAI_API_KEY=tu_clave_privada

# Si no vas a usar voz externa, desactiva la transcripción:
# ORDERVOICE_BROWSER_STT_PROVIDER=disabled

# NO se usan ORDERVOICE_PROVIDER, ORDERVOICE_INTENT_MODEL, Ollama ni Twilio.
# El motor de interpretación de pedidos es LOCAL y la base es PostgreSQL.
