# Por defecto se usa Ollama local (sin API de pago).
# Copia a .env.local solo si deseas cambiar los valores por defecto.
ORDERVOICE_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:3b

# Opción alternativa: ORDERVOICE_PROVIDER=demo (reglas básicas, sin modelo)
# OpenAI es opcional y puede generar cargos SOLO si seleccionas ORDERVOICE_PROVIDER=openai.
# OPENAI_API_KEY=
# OPENAI_MODEL=
