{
  "name": "ordervoice-ai",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:init": "node --env-file-if-exists=.env.local scripts/db-init.mjs",
    "test:orders": "node scripts/test-order-engine.cjs",
    "test:dialogue": "node scripts/test-dialogue.cjs",
    "test:fast": "node scripts/test-fast-intents.cjs",
    "test:browser:voice": "node scripts/test-browser-voice.cjs",
    "test:handsfree": "node scripts/test-handsfree-vad.cjs",
    "test:voice:currency": "node scripts/test-voice-currency.cjs",
    "test:monolith": "node --test tests/monolith.test.mjs",
    "test:monolith:http": "node --env-file-if-exists=.env.local scripts/smoke-monolith.mjs",
    "test": "npm run typecheck && npm run test:monolith && npm run test:orders && npm run test:dialogue && npm run test:fast && npm run test:browser:voice && npm run test:handsfree && npm run test:voice:currency"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
